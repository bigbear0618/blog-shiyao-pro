#!/usr/bin/env bash
# publish-blog — 一键发布 HTML 到 blog.shiyao.pro
#
# 用法:
#   publish-blog <file.html> [选项]
#
# 选项:
#   --slug NAME       自定义 URL slug (默认: 文件名去掉 .html)
#   --title TEXT      指定标题 (默认: 从 <title> 提取)
#   --summary TEXT    指定摘要 (默认: 从 <meta name="description"> 提取)
#   --tag TEXT        标签 (如 DevOps / AI / 笔记)
#   --no-index        只发布,不更新首页列表
#   --force           已存在时强制覆盖
#   -h, --help        显示帮助

set -euo pipefail

BLOG_ROOT="/var/www/blog.shiyao.pro"
DOMAIN="https://blog.shiyao.pro"
INDEX="$BLOG_ROOT/index.html"
OWNER="nginx:nginx"
MARKER="<!-- 新增文章时"

C_GREEN='\033[0;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[0;31m'
C_CYAN='\033[0;36m'
C_RESET='\033[0m'

info()  { printf "${C_CYAN}→${C_RESET} %s\n" "$*"; }
ok()    { printf "${C_GREEN}✓${C_RESET} %s\n" "$*"; }
warn()  { printf "${C_YELLOW}⚠${C_RESET} %s\n" "$*"; }
fail()  { printf "${C_RED}✗${C_RESET} %s\n" "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
publish-blog — 一键发布 HTML 到 blog.shiyao.pro

用法:
  publish-blog <file.html> [选项]

选项:
  --slug NAME       自定义 URL slug (默认: 文件名去掉 .html)
  --title TEXT      指定标题 (默认: 从 <title> 提取)
  --summary TEXT    指定摘要 (默认: 从 <meta name="description"> 提取)
  --tag TEXT        标签 (如 DevOps / AI / 笔记)
  --no-index        只发布,不更新首页列表
  --force           已存在时强制覆盖
  -h, --help        显示帮助
EOF
  exit "${1:-0}"
}

# ---------- 解析参数 ----------
FILE=""
SLUG=""
TITLE=""
SUMMARY=""
TAG=""
NO_INDEX=0
FORCE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug)     SLUG="${2:-}"; shift 2;;
    --title)    TITLE="${2:-}"; shift 2;;
    --summary)  SUMMARY="${2:-}"; shift 2;;
    --tag)      TAG="${2:-}"; shift 2;;
    --no-index) NO_INDEX=1; shift;;
    --force)    FORCE=1; shift;;
    -h|--help)  usage 0;;
    -*) fail "未知选项: $1";;
    *)
      if [[ -z "$FILE" ]]; then FILE="$1"; shift
      else fail "多余参数: $1"
      fi
      ;;
  esac
done

[[ -z "$FILE" ]] && usage 2
[[ -f "$FILE" ]] || fail "文件不存在: $FILE"
[[ "${FILE##*.}" == "html" ]] || fail "文件必须以 .html 结尾"

# ---------- 推导 slug ----------
BASENAME=$(basename "$FILE")
[[ -z "$SLUG" ]] && SLUG="${BASENAME%.html}"

if [[ ! "$SLUG" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  fail "slug 只能包含 [a-zA-Z0-9_-]: '$SLUG'"
fi

TARGET="$BLOG_ROOT/$SLUG.html"

if [[ -e "$TARGET" && "$FORCE" -ne 1 ]]; then
  fail "$TARGET 已存在,使用 --force 覆盖"
fi

# ---------- 自动提取 title / description ----------
if [[ -z "$TITLE" ]]; then
  RAW_TITLE=$(grep -oP '(?<=<title>)[^<]+' "$FILE" | head -1 || true)
  TITLE="${RAW_TITLE%% — *}"
  TITLE="${TITLE%% · *}"
  TITLE="${TITLE## }"; TITLE="${TITLE%% }"
fi

if [[ -z "$SUMMARY" ]]; then
  SUMMARY=$(grep -oP '(?<=name="description" content=")[^"]+' "$FILE" | head -1 || true)
fi

DATE=$(date +%Y-%m-%d)

# ---------- 复制文件 ----------
info "发布 $BASENAME → $SLUG.html"
sudo cp "$FILE" "$TARGET"
sudo chown "$OWNER" "$TARGET"
sudo chmod 644 "$TARGET"
ok "已部署到 $TARGET"
ok "URL: $DOMAIN/$SLUG"

# ---------- 更新首页 ----------
if [[ "$NO_INDEX" -eq 1 ]]; then
  warn "跳过首页更新 (--no-index)"
  exit 0
fi

if [[ -z "$TITLE" ]]; then
  warn "未提取到标题,跳过首页更新 (可用 --title 重试)"
  exit 0
fi

[[ -f "$INDEX" ]] || { warn "首页不存在,跳过"; exit 0; }

if ! sudo grep -qF "$MARKER" "$INDEX"; then
  warn "首页缺少插入标记 '$MARKER',跳过更新"
  exit 0
fi

# 幂等: 如果同 slug 的链接已在首页,先移除旧条目
if sudo grep -qE "href=\"/$SLUG\"" "$INDEX"; then
  info "首页已有同 slug 条目,先移除旧的"
  TMP_RM=$(mktemp)
  # 仅匹配独占一行的 <li> / </li> (避免被 HTML 注释里的字面字符串误中)
  sudo awk -v slug="$SLUG" '
    /^[[:space:]]*<li>[[:space:]]*$/ {
      buf=$0; in_li=1; found=0; next
    }
    in_li {
      buf = buf ORS $0
      if (index($0, "href=\"/" slug "\"")) found=1
      if ($0 ~ /^[[:space:]]*<\/li>[[:space:]]*$/) {
        if (!found) print buf
        in_li=0; buf=""; found=0
      }
      next
    }
    { print }
  ' "$INDEX" > "$TMP_RM"
  sudo cp "$TMP_RM" "$INDEX"
  rm -f "$TMP_RM"
fi

# 构造 <li> 块
TAG_HTML=""
[[ -n "$TAG" ]] && TAG_HTML="<span class=\"tag\">$TAG</span>"

LI_BLOCK="      <li>
        <a class=\"post\" href=\"/$SLUG\">
          <div class=\"post-meta\">$DATE${TAG:+ · $TAG}</div>
          <div class=\"post-title\">$TITLE$TAG_HTML</div>
          <div class=\"post-summary\">$SUMMARY</div>
        </a>
      </li>
"

TMP=$(mktemp)
sudo awk -v block="$LI_BLOCK" -v marker="$MARKER" '
  index($0, marker) { print block; print; next }
  { print }
' "$INDEX" > "$TMP"
sudo cp "$TMP" "$INDEX"
sudo chown "$OWNER" "$INDEX"
sudo chmod 644 "$INDEX"
rm -f "$TMP"
ok "已加入首页列表"
echo
info "完成! 访问 $DOMAIN/$SLUG"
