#!/usr/bin/env python3
"""Local-only helper for ai-daily.html image generation.

Run:
  python3 scripts/local-image-helper

Then open https://blog.shiyao.pro/ai-daily and use the image prompt panel.

By default this calls local Codex CLI and asks it to save a PNG file. If your
Codex surface does not expose image generation, provide AI_IMAGE_COMMAND:

  AI_IMAGE_COMMAND='my-image-cli --prompt "{prompt}" --output "{output}"' \
    python3 scripts/local-image-helper
"""

from __future__ import annotations

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import json
import os
import shlex
import subprocess
import time
import urllib.parse


HOST = os.environ.get("AI_IMAGE_HELPER_HOST", "127.0.0.1")
PORT = int(os.environ.get("AI_IMAGE_HELPER_PORT", "8787"))
ROOT = Path(__file__).resolve().parents[1]
OUT_DIR = Path(os.environ.get("AI_IMAGE_OUTPUT_DIR", ROOT / ".local-ai-images")).expanduser()
TIMEOUT = int(os.environ.get("AI_IMAGE_TIMEOUT", "900"))
TOKEN = os.environ.get("AI_IMAGE_TOKEN", "").strip()
PUBLIC_BASE = os.environ.get("AI_IMAGE_PUBLIC_BASE", "/ai-image").rstrip("/")


def safe_name() -> str:
    return time.strftime("codex-image-%Y%m%d-%H%M%S.png")


def run_generation(prompt: str, output: Path) -> subprocess.CompletedProcess[str]:
    custom = os.environ.get("AI_IMAGE_COMMAND")
    if custom:
        command = custom.format(prompt=prompt.replace('"', '\\"'), output=str(output))
        return subprocess.run(command, shell=True, cwd=ROOT, text=True, capture_output=True, timeout=TIMEOUT)

    codex_prompt = f"""
Generate one image from this prompt and save the final PNG exactly at:
{output}

Prompt:
{prompt}

Requirements:
- Create a real PNG file at the requested path.
- Do not ask follow-up questions.
- If image generation tools are unavailable in this Codex environment, explain that in the final message.
"""
    cmd = [
        "codex",
        "exec",
        "--cd",
        str(ROOT),
        "--sandbox",
        "danger-full-access",
        codex_prompt,
    ]
    return subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True, timeout=TIMEOUT)


class Handler(BaseHTTPRequestHandler):
    def end_headers(self) -> None:
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Image-Token")
        super().end_headers()

    def do_OPTIONS(self) -> None:
        self.send_response(204)
        self.end_headers()

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/health":
            self.json(200, {"ok": True})
            return
        if parsed.path.startswith("/images/"):
            if not self.authorized(parsed):
                self.json(401, {"ok": False, "error": "unauthorized"})
                return
            name = Path(parsed.path).name
            image = OUT_DIR / name
            if not image.exists():
                self.json(404, {"ok": False, "error": "image not found"})
                return
            self.send_response(200)
            self.send_header("Content-Type", "image/png")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(image.read_bytes())
            return
        self.json(404, {"ok": False, "error": "not found"})

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/generate-image":
            self.json(404, {"ok": False, "error": "not found"})
            return
        length = int(self.headers.get("Content-Length", "0"))
        if length > 20000:
            self.json(413, {"ok": False, "error": "prompt too large"})
            return
        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
        except Exception:
            self.json(400, {"ok": False, "error": "invalid json"})
            return
        if not self.authorized(parsed, payload):
            self.json(401, {"ok": False, "error": "unauthorized"})
            return
        prompt = str(payload.get("prompt", "")).strip()
        if not prompt:
            self.json(400, {"ok": False, "error": "missing prompt"})
            return

        OUT_DIR.mkdir(parents=True, exist_ok=True)
        filename = safe_name()
        output = OUT_DIR / filename
        try:
            result = run_generation(prompt, output)
        except subprocess.TimeoutExpired:
            self.json(504, {"ok": False, "error": f"generation timed out after {TIMEOUT}s"})
            return
        except FileNotFoundError as exc:
            self.json(500, {"ok": False, "error": f"command not found: {exc}"})
            return

        if not output.exists() or output.stat().st_size == 0:
            detail = (result.stdout + "\n" + result.stderr).strip()
            self.json(500, {
                "ok": False,
                "error": "Codex finished but no PNG was created. Configure AI_IMAGE_COMMAND if this Codex install has no image tool.",
                "detail": detail[-3000:],
            })
            return

        self.json(200, {
            "ok": True,
            "filename": filename,
            "image_url": image_url(filename),
        })

    def authorized(self, parsed: urllib.parse.ParseResult, payload: dict | None = None) -> bool:
        if not TOKEN:
            return True
        query = urllib.parse.parse_qs(parsed.query)
        body_token = ""
        if payload:
            body_token = str(payload.get("token", "")).strip()
        supplied = body_token or self.headers.get("X-Image-Token", "") or (query.get("token", [""])[0])
        return supplied == TOKEN

    def json(self, status: int, payload: dict) -> None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt: str, *args) -> None:
        print(f"{self.address_string()} - {fmt % args}")


def image_url(filename: str) -> str:
    if TOKEN:
        return f"{PUBLIC_BASE}/images/{filename}?token={urllib.parse.quote(TOKEN)}"
    return f"{PUBLIC_BASE}/images/{filename}"


def main() -> int:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"AI image helper listening on http://{HOST}:{PORT}")
    print(f"output dir: {OUT_DIR}")
    print(f"token auth: {'enabled' if TOKEN else 'disabled'}")
    print("open https://blog.shiyao.pro/ai-daily and submit a prompt")
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
